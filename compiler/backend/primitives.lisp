    ("list" . "list") ("cons" . "cons") ("car" . "car") ("cdr" . "cdr")
    ("vector" . "vector") ("values" . "values") ("apply" . "apply")
    ;; Classes and functions (chapters 10 and 11)
    ("object-class" . "object_class") ("instance?" . "instance_p")
    ("subclass?" . "subclass_p") ("singleton" . "singleton")
    ("all-superclasses" . "all_superclasses")
    ("direct-superclasses" . "direct_superclasses")
    ("direct-subclasses" . "direct_subclasses")
    ("generic-function-methods" . "generic_function_methods")
    ("method-specializers" . "method_specializers")
    ("applicable-method?" . "applicable_method_p")
    ("sorted-applicable-methods" . "sorted_applicable_methods")
    ("find-method" . "find_method")
    ("seal" . "seal") ("make-read-only" . "seal")
    ;; Conditions (chapter 13)
    ("do-handlers" . "do_handlers")
    ;; Threads (Phase 7)
    ("current-thread" . "current_thread") ("thread-yield" . "thread_yield")
    ("acquire-lock" . "acquire_lock") ("release-lock" . "release_lock")
    ("wait-condition-variable" . "wait_condition_variable")
    ("notify-condition-variable" . "notify_condition_variable")
    ("notify-all-condition-variable" . "notify_all_condition_variable")
    ("atomic-value" . "atomic_value") ("atomic-add!" . "atomic_add")
    ("atomic-compare-and-swap!" . "atomic_compare_and_swap")
    ;; What the library is written on (runtime/c/library.c and others)
    ("%make" . "make")
    ("%signal" . "signal_condition") ("%set-error-hooks" . "set_error_hooks")
    ("%set-sequence-hook" . "set_sequence_hook")
    ("%make-generic-function" . "make_generic_function")
    ("%format-message" . "format_message") ("%die" . "die") ("%warn" . "warn")
    ("%break" . "break_message")
    ("%make-thread" . "make_thread") ("%join-thread" . "join_thread")
    ("%thread-condition" . "thread_condition") ("%unhandled" . "unhandled")
    ("%number-add" . "number_add") ("%number-sub" . "number_sub")
    ("%number-mul" . "number_mul") ("%number-div" . "number_div")
    ("%number-negate" . "number_negate") ("%number=" . "number_equal")
    ("%number<" . "number_less") ("%number?" . "number_p")
    ("%divide" . "divide") ("%math" . "math") ("%float?" . "float_p")
    ("%float" . "to_float") ("%numerator" . "numerator")
    ("%denominator" . "denominator") ("%rationalize" . "rationalize")
    ("%logand" . "logand") ("%logior" . "logior") ("%logxor" . "logxor")
    ("%lognot" . "lognot") ("%logbit?" . "logbit_p") ("%ash" . "ash")
    ("%gcd" . "gcd")
    ("%character->integer" . "character_to_integer")
    ("%integer->character" . "integer_to_character")
    ("%character?" . "character_p") ("%char-upcase" . "char_upcase")
    ("%char-downcase" . "char_downcase")
    ("%vector-size" . "vector_size") ("%vector-element" . "vector_element")
    ("%vector-element-setter" . "vector_element_setter")
    ("%make-vector" . "make_vector") ("%make-byte-string" . "make_byte_string")
    ("%make-unicode-string" . "make_unicode_string")
    ("%replace-vector!" . "replace_vector")
    ("%set-car!" . "set_car") ("%set-cdr!" . "set_cdr") ("%pair?" . "pair_p")
