(in-package #:dylan)

;;; Forward references to the class objects built in class-structure.lisp
;;; and to the Dylan-callable runtime procedures.
(declaim (special <object>))

(declaim (inline id?))
(defun id? (object-1 object-2)
  ;; EQL, not EQ: numbers and characters that are the same value are the
  ;; same object in Dylan, but need not be EQ in Common Lisp (floats and
  ;; bignums, for instance).
  (eql object-1 object-2))

(defun dylan%false-fn () nil)

;;;; Lisp structure for representing the Dylan class DAG

(defstruct (dylan-class
            (:conc-name class.)
            (:predicate class?)
            (:print-object print-opaque-object)
            (:constructor make-class (debug-name instances subclasses
                                      superclasses slots class-data
                                      instance-data-size sealed? read-only?
                                      abstract? specificity
                                      specificity-token)))
  debug-name                            ; Name, for debugging
  instances                             ; Population of all direct
                                        ; instances of this class
  subclasses                            ; Population of all direct
                                        ; subclasses of this class
  superclasses                          ; Ordered list of direct superclasses
  slots                                 ; Vector of slot descriptors
  class-data                            ; Vector of data belonging to this
                                        ; class -- either from CLASS
                                        ; allocated data in one of my slots
                                        ; or from ALL-SUBCLASSES from
                                        ; inherited slots
  instance-data-size                    ; Number of slots in each INSTANCE
  sealed?                               ; Has the class been sealed?
  read-only?
  abstract?                             ; Is the class abstract?
  specificity                           ; Longest path from root.
  specificity-token                     ; Unique to a specificity labeling.
  (precedence-list nil))                ; Cached; see CLASS-PRECEDENCE-LIST

;;;; Lisp structure for representing Dylan singletons

(defstruct (dylan-singleton
            (:conc-name singleton.)
            (:predicate singleton?)
            (:print-object print-opaque-object)
            (:constructor make-singleton (object extra-slot-descriptors
                                          extra-slot-values)))
  object                                ; The actual singleton object
  extra-slot-descriptors                ; Vector of slot descriptors for
                                        ; slots only in the singleton and
                                        ; not in the class definition
  extra-slot-values)                    ; Vector of extra slot data

;;;; Lisp structure for representing Dylan slot descriptors
;;;
;;; Moved to support.lisp -- used by the compiler and the runtime.

;;;; Lisp structure for representing Dylan instances

(defstruct (dylan-instance
            (:conc-name instance.)
            (:predicate instance?)
            (:print-object print-opaque-object)
            (:constructor make-dylan-instance (class singleton data)))
  class                                 ; Direct class of this object
  singleton                             ; Singleton for this obj. (or NIL)
  data)                                 ; Vector of object's instance data

;;;; And now the good stuff ...

(defun test-that-all-slots-for-this-getter-are-identical (my-slot my-getter slots)
  (flet ((slots-equal? (slot1 slot2)
           (every (lambda (f) (eq (funcall f slot1) (funcall f slot2)))
                  (list #'slot.debug-name #'slot.getter #'slot.setter
                        #'slot.type #'slot.init-value #'slot.init-function
                        #'slot.init-keyword #'slot.required-init-keyword
                        #'slot.allocation))))
    (dolist (slot slots t)
      (when (eq (slot.getter slot) my-getter)
        (unless (slots-equal? my-slot slot)
          (dylan-call dylan/error "multiple inheritance slot clash"
                      my-slot slot))))))

(defun vector-iterate (v fn)
  (dotimes (i (length v))
    (funcall fn i (aref v i))))

(defun grow-vector (v &rest values)
  (let* ((n-old-values (length v))
         (new-v (make-array (+ n-old-values (length values)))))
    (replace new-v v)
    (loop for value in values
          for i from n-old-values
          do (setf (aref new-v i) value))
    new-v))

(defun find-empty-slot (v)
  (position nil v))

(defun set-next-vector-entry! (vec value update-vec!)
  (let ((next-entry (find-empty-slot vec)))
    (if next-entry
        (setf (aref vec next-entry) value)
        (let ((new-vec (apply #'grow-vector vec (make-list 10))))
          (funcall update-vec! new-vec)
          (set-next-vector-entry! new-vec value update-vec!)))))

(defun copy-slot (slot inherited? data-location)
  (let ((copy (make-slot (slot.debug-name slot) (slot.getter slot)
                         (slot.setter slot) (slot.type slot)
                         (slot.init-value slot) (slot.has-initial-value? slot)
                         (slot.init-function slot) (slot.init-keyword slot)
                         (slot.required-init-keyword slot)
                         (slot.allocation slot) inherited? data-location)))
    (setf (slot.filtered copy) (slot.filtered slot))
    copy))

;;; Filtered slots (chapter 6): a virtual slot that overrides an inherited
;;; slot keeps that slot's storage, which the inherited accessor methods
;;; reach by NEXT-METHOD.  SLOT-STORAGE is the slot that holds a slot's
;;; value, if any.

(defun slot-storage (slot)
  (if (eq (slot.allocation slot) 'virtual)
      (slot.filtered slot)
      slot))

(defun storage-location (class getter)
  "Where CLASS keeps the value read by GETTER."
  (let ((slot (same-slot-getter-in-slot-vector->slot getter (class.slots class))))
    (slot.data-location (or (and slot (slot-storage slot))
                            (dylan-call dylan/error
                                        "slot has no storage" class getter)))))

;;; The class whose own slot is the one CLASS has for GETTER: CLASS itself
;;; if the slot is not inherited, otherwise the most specific of the
;;; origins found through its direct superclasses.

(defun slot-origin (class getter)
  (let ((slot (same-slot-getter-in-slot-vector->slot getter (class.slots class))))
    (if (and slot (not (slot.inherited? slot)))
        class
        (let ((origins
                (loop for super in (class.superclasses class)
                      when (same-slot-getter-in-slot-vector->slot
                            getter (class.slots super))
                        collect (slot-origin super getter))))
          (or (find-if (lambda (origin)
                         (every (lambda (other) (subclass? origin other))
                                origins))
                       origins)
              (car origins))))))

(defun combine-slots (class superclasses new-getter-fns)
  "Merge the slots CLASS inherits from SUPERCLASSES (in order), and give
CLASS its own accessor methods for each of them.  Answers a vector of the
slot vector, the class-data size and the instance-data size."
  (let ((entries '())                   ; (slot . origin), newest first
        (class-data-index -1)
        (instance-data-index -1))
    ;; First decide which slot descriptor CLASS inherits for each getter.
    ;; The same slot reached along two paths is inherited once; where one
    ;; path has overridden it (its origin is a subclass of the other's),
    ;; the more specific slot wins; otherwise the two must be identical.
    (dolist (super superclasses)
      (loop for slot across (class.slots super)
            when slot
              do (let* ((getter (slot.getter slot))
                        (origin (slot-origin super getter))
                        (entry (find getter entries
                                     :key (lambda (e) (slot.getter (car e))))))
                   (cond ((null entry) (push (cons slot origin) entries))
                         ((member getter new-getter-fns)) ; Being overridden
                         ((or (eq origin (cdr entry))
                              (subclass? (cdr entry) origin)))
                         ((subclass? origin (cdr entry))
                          (setf (car entry) slot
                                (cdr entry) origin))
                         (t (test-that-all-slots-for-this-getter-are-identical
                             slot getter (list (car entry))))))))
    ;; Then lay out the data.  CLASS always gets accessor methods of its
    ;; own: a slot's offset in CLASS may differ from its offset in a
    ;; superclass, and a superclass's method could otherwise be the most
    ;; specific one that applies.  (The Scheme added them only when the
    ;; offset differed from the first superclass's, so a getter from
    ;; another inheritance path could win and read the wrong offset.)
    ;; A getter CLASS redefines gets no inherited methods here: the slot
    ;; CLASS defines supplies its own, and a virtual one's are the user's.
    (labels ((figure-slot-data-location (slot methods?)
               (case (slot.allocation slot)
                 ((class constant) (slot.data-location slot))
                 ((instance)
                  (incf instance-data-index)
                  (when methods?
                    (add-method (slot.getter slot)
                                (make-instance-getter class instance-data-index
                                                      (slot.debug-name slot)
                                                      (slot.getter slot)))
                    (when (slot.setter slot)
                      (add-method (slot.setter slot)
                                  (make-instance-setter class instance-data-index
                                                        (slot.type slot)
                                                        (slot.getter slot)))))
                  instance-data-index)
                 ((each-subclass)
                  (incf class-data-index)
                  (when methods?
                    (add-method (slot.getter slot)
                                (make-each-subclass-getter class class-data-index
                                                           (slot.debug-name slot)
                                                           (slot.getter slot)))
                    (when (slot.setter slot)
                      (add-method (slot.setter slot)
                                  (make-each-subclass-setter class class-data-index
                                                             (slot.type slot)
                                                             (slot.getter slot)))))
                  class-data-index)
                 ((virtual) nil)))
             (inherit (slot)
               (let ((copy (copy-slot slot t
                                      (figure-slot-data-location
                                       slot (not (member (slot.getter slot)
                                                         new-getter-fns))))))
                 (when (slot.filtered slot)
                   (setf (slot.filtered copy)
                         (copy-slot (slot.filtered slot) t
                                    (figure-slot-data-location
                                     (slot.filtered slot) nil))))
                 copy)))
      (let ((final-slot-list
              (mapcar (lambda (entry) (inherit (car entry)))
                      (reverse entries))))
        (vector (coerce final-slot-list 'simple-vector)
                (+ 1 class-data-index)
                (+ 1 instance-data-index))))))

;;; The class precedence list, computed as CLOS does: a topological sort of
;;; the class and its superclasses that keeps each class before its direct
;;; superclasses and those in their declared order, breaking ties in favour
;;; of the candidate with a direct subclass furthest along the list so far.

(defun compute-class-precedence-list (class)
  (let ((classes '()))
    (labels ((collect (c)
               (unless (member c classes)
                 (push c classes)
                 (mapc #'collect (class.superclasses c)))))
      (collect class))
    (let ((constraints '()))            ; (before . after)
      (dolist (c classes)
        (loop for before in (cons c (class.superclasses c))
              for after in (class.superclasses c)
              do (push (cons before after) constraints)))
      (let ((result '())
            (remaining (reverse classes)))
        (loop while remaining
              do (let ((candidates
                         (remove-if (lambda (c)
                                      (find-if (lambda (constraint)
                                                 (and (eq (cdr constraint) c)
                                                      (member (car constraint)
                                                              remaining)))
                                               constraints))
                                    remaining)))
                   (when (null candidates)
                     (dylan-call dylan/error
                                 "inconsistent class precedence"
                                 (class.debug-name class)))
                   (let ((next
                           (if (null (cdr candidates))
                               (car candidates)
                               (or (dolist (c result nil) ; most recent first
                                     (let ((hit (find-if
                                                 (lambda (candidate)
                                                   (member candidate
                                                           (class.superclasses c)))
                                                 candidates)))
                                       (when hit (return hit))))
                                   (car candidates)))))
                     (push next result)
                     (setf remaining (remove next remaining)))))
        (reverse result)))))

(defun class-precedence-list (class)
  (or (class.precedence-list class)
      (setf (class.precedence-list class)
            (compute-class-precedence-list class))))

(defun recompute-class-specificities! ()
  (let ((new-token (cons 'specificity 'token)))
    (labels ((level-me (me level)
               (if (eq new-token (class.specificity-token me))
                   (when (> level (class.specificity me))
                     (setf (class.specificity me) level))
                   (progn
                     (setf (class.specificity-token me) new-token)
                     (setf (class.specificity me) level)))
               (let ((sublevel (+ 1 level)))
                 (map-over-population!
                  (class.subclasses me)
                  (lambda (subclass) (level-me subclass sublevel))))))
      (level-me <object> 0))))

(defun get-initial-slot-value (slot)
  (let ((f (slot.init-function slot)))
    (cond (f (dylan-call f))
          ((not (slot.has-initial-value? slot)) *the-uninitialized-slot-value*)
          (t (slot.init-value slot)))))

(defun initialize-slot! (slot keywords vector which-allocation-types)
  (when (slot.filtered slot)
    (return-from initialize-slot!
      (initialize-slot! (slot.filtered slot) keywords vector
                        which-allocation-types)))
  (let ((allocation (slot.allocation slot)))
    (when (member allocation which-allocation-types)
      (case allocation
        ((instance each-subclass)
         (let ((keyword (or (slot.required-init-keyword slot)
                            (slot.init-keyword slot))))
           (setf (aref vector (slot.data-location slot))
                 (if keyword
                     (dylan%find-keyword keywords keyword
                                          (lambda () (get-initial-slot-value slot)))
                     (get-initial-slot-value slot)))))
        ((class)
         (setf (aref vector (cdr (slot.data-location slot)))
               (get-initial-slot-value slot)))
        ((virtual constant) 'done))))
  'done)

(defun dylan%make-a-class (name superclasses new-getter-fns)
  (make-dylan-class name superclasses new-getter-fns nil))

(defun make-dylan-class (name superclasses new-getter-fns top?)
  (when (and (not top?) (null superclasses))
    (dylan-call dylan/error "must specify at least one superclass"))
  (unless (unique? superclasses #'member)
    (dylan-call dylan/error "multiple inheritance from identical superclasses"))
  (dolist (superclass superclasses)
    (when (class.sealed? superclass)
      (dylan-call dylan/error "cannot subclass a sealed class" superclass)))
  (let* ((the-class
           (make-class name                     ; debug-name
                       (make-population*)       ; instances
                       (make-population*)       ; subclasses
                       superclasses             ; superclasses
                       (vector)                 ; slots
                       (vector)                 ; class-data
                       0                        ; instance-data-size
                       nil                      ; sealed?
                       nil                      ; read-only?
                       nil                      ; abstract?
                       nil                      ; specificity
                       nil))                    ; specificity-token
         (combined-slots
           (progn
             (class-precedence-list the-class) ; Signals if inconsistent
             (combine-slots the-class superclasses new-getter-fns)))
         (slots (aref combined-slots 0))
         (class-data-size (aref combined-slots 1))
         (instance-data-size (aref combined-slots 2)))
    (setf (class.slots the-class) slots)
    (setf (class.class-data the-class)
          ;; Design note: we flatten out the slot list here to make
          ;; instance creation fast at the expense of speed of class
          ;; redefinition and space.
          (let ((result (make-array class-data-size
                                    :initial-element *the-uninitialized-slot-value*)))
            (vector-iterate slots
                            (lambda (i slot)
                              (declare (ignore i))
                              (initialize-slot! slot '() result '(each-subclass))))
            result))
    (setf (class.instance-data-size the-class) instance-data-size)
    (dolist (parent-class superclasses)
      (add-to-population! (class.subclasses parent-class) the-class))
    (unless top? (recompute-class-specificities!))
    the-class))

(defun subclass? (class1 class2)
  "Is CLASS1 a subclass of CLASS2?"
  (or (id? class1 class2)
      (loop with classes-left = (class.superclasses class1)
            do (cond ((null classes-left) (return nil))
                     ((id? class2 (car classes-left)) (return t))
                     (t (setf classes-left
                              (append (class.superclasses (car classes-left))
                                      (cdr classes-left))))))))

(defun add-slot (owner &rest keyword-list)
  "Keywords allowed are: getter, setter, type, init-value, init-function,
init-keyword, required-init-keyword, debug-name, and allocation.  See page 52."
  (dylan%keyword-validate
   nil keyword-list
   '(:getter :setter :type :init-value :init-function :init-keyword
     :required-init-keyword :allocation :debug-name))
  (let* ((getter (dylan%find-keyword
                  keyword-list :getter
                  (lambda () (dylan-call dylan/error "no getter defined"))))
         (setter (dylan%find-keyword keyword-list :setter #'dylan%false-fn))
         (type (dylan%find-keyword keyword-list :type (lambda () <object>)))
         (have-init-value? t)
         (init-value (dylan%find-keyword
                      keyword-list :init-value
                      (lambda () (setf have-init-value? nil) 'no-value)))
         (init-function (dylan%find-keyword keyword-list :init-function
                                             #'dylan%false-fn))
         (init-keyword (dylan%find-keyword keyword-list :init-keyword
                                            #'dylan%false-fn))
         (allocation (dylan%find-keyword keyword-list :allocation
                                          (lambda () 'instance)))
         (debug-name (dylan%find-keyword keyword-list :debug-name
                                          (lambda () '*the-unnamed-slot*)))
         (required-init-keyword (dylan%find-keyword
                                 keyword-list :required-init-keyword
                                 (lambda () nil))))
    (dylan%add-slot owner type allocation setter getter debug-name init-value
                     have-init-value? init-function init-keyword
                     required-init-keyword)))

(defun same-slot-getter-in-slot-vector->slot (getter slots)
  (find-if (lambda (slot) (and slot (id? (slot.getter slot) getter))) slots))

(defun conflict-test (owner new-slot)
  (flet ((stricter-than-all? (type type-list)
           ;; TYPE-LIST may contain NIL entries!
           (every (lambda (other) (or (null other) (subclass? type other)))
                  type-list)))
    (unless (stricter-than-all?
             (slot.type new-slot)
             (mapcar (lambda (class)
                       (let ((slot (same-slot-getter-in-slot-vector->slot
                                    (slot.getter new-slot)
                                    (class.slots class))))
                         (and slot (slot.type slot))))
                     (class.superclasses
                      (if (class? owner)
                          owner
                          (instance.class (singleton.object owner))))))
      (dylan-call dylan/error
                  "conflict-test -- new slot type not a subclass of inherited type"
                  'owner owner
                  'new-slot new-slot
                  'new-slot-type (slot.type new-slot)))))

(defun remove-this-slot-only! (owner slot-vector slot)
  (vector-iterate
   slot-vector
   (lambda (index entry)
     (when (id? slot entry)
       (let ((allocation (slot.allocation slot))
             (data-location (slot.data-location slot)))
         (setf (aref slot-vector index) nil)
         (if (class? owner)
             (case allocation
               ((class)
                (when (eq (car data-location) owner)
                  (setf (aref (class.class-data owner) (cdr data-location))
                        '<<empty-slot-value>>)))
               ((each-subclass)
                (setf (aref (class.class-data owner) data-location)
                      '<<empty-slot-value>>))
               ((instance)
                (map-over-population
                 (class.instances owner)
                 (lambda (ins)
                   (setf (aref (instance.data ins) data-location)
                         '<<empty-slot-value>>)))))
             ;; Not a class, must be a singleton.  (The Scheme wrote
             ;; directly into OWNER with VECTOR-SET!, which happened to
             ;; work only because MIT Scheme records were vectors; the
             ;; extra-slot-values vector is what was meant.)
             (when (eq allocation 'instance)
               (setf (aref (singleton.extra-slot-values owner) data-location)
                     '<<empty-slot-value>>))))))))

;;; ADD-A-SLOT's updater is called as (updater owner new-vector), which is
;;; the opposite argument order from a (SETF ...) function, so the two
;;; updaters needed here get names of their own.

(defun set-class-slots! (class new-vector)
  (setf (class.slots class) new-vector))

(defun set-singleton-extra-slot-descriptors! (singleton new-vector)
  (setf (singleton.extra-slot-descriptors singleton) new-vector))

(defun add-a-slot (owner new-slot accessor updater fixit-fn)
  "Add NEW-SLOT (a slot descriptor) to OWNER, using ACCESSOR to find the
current vector of slot descriptors and UPDATER to store the modified vector
back if needed.  FIXIT-FN is then called with the owner and the slot
descriptor to update the instances as needed."
  (let* ((current-descriptors (funcall accessor owner))
         (getter (slot.getter new-slot))
         (old-slot (same-slot-getter-in-slot-vector->slot
                    getter current-descriptors)))
    (when old-slot                      ; Redefining existing slot
      (when (slot.inherited? old-slot)
        (conflict-test owner new-slot))
      (if (and (eq (slot.allocation new-slot) 'virtual)
               (slot.inherited? old-slot)
               (slot-storage old-slot))
          ;; A filtered slot: keep the inherited slot's storage.
          (progn
            (setf (slot.filtered new-slot) (slot-storage old-slot))
            (setf (aref current-descriptors
                        (position old-slot current-descriptors))
                  nil))
          (remove-this-slot-only! owner current-descriptors old-slot))
      (setf current-descriptors (funcall accessor owner)))
    (let ((offset (find-empty-slot current-descriptors)))
      (if offset
          (setf (aref current-descriptors offset) new-slot)
          (funcall updater owner (grow-vector current-descriptors new-slot)))
      (funcall fixit-fn owner new-slot))))

(defun map-over-all-subclasses! (predicate fn classes)
  "PREDICATE answers true if you want to continue to the children of a
class.  FN receives two arguments: a class and (PREDICATE class).  Classes
appear only once, even if multiple inheritance makes a non-tree."
  (loop with subclasses = (population->list classes)
        with already-seen = '()
        do (if (null subclasses)
               (return 'done)
               (let* ((this-subclass (car subclasses))
                      (test (funcall predicate this-subclass)))
                 (unless (member this-subclass already-seen)
                   (funcall fn this-subclass test))
                 (setf subclasses
                       (if test
                           (append (cdr subclasses)
                                   (population->list
                                    (class.subclasses (car subclasses))))
                           (cdr subclasses)))
                 (push this-subclass already-seen)))))

(defun map-over-all-superclasses! (class fn)
  "Call FN on each superclass of CLASS, once each, in precedence order, and
answer the class precedence list."
  (let ((precedence-list (class-precedence-list class)))
    (mapc fn (cdr precedence-list))
    (copy-list precedence-list)))

(defun add-slot-to-class! (class new-slot)
  (case (slot.allocation new-slot)
    ((instance)
     (map-over-population!
      (class.instances class)
      (lambda (instance)
        (setf (instance.data instance)
              (grow-vector (instance.data instance)
                           (get-initial-slot-value new-slot)))))
     (add-method (slot.getter new-slot)
                 (make-instance-getter class
                                       (class.instance-data-size class)
                                       (slot.debug-name new-slot)
                                       (slot.getter new-slot)))
     (when (slot.setter new-slot)
       (add-method (slot.setter new-slot)
                   (make-instance-setter class
                                         (class.instance-data-size class)
                                         (slot.type new-slot)
                                         (slot.getter new-slot))))
     (incf (class.instance-data-size class)))
    ((each-subclass)
     (add-method (slot.getter new-slot)
                 (make-each-subclass-getter class
                                            (length (class.class-data class))
                                            (slot.debug-name new-slot)
                                            (slot.getter new-slot)))
     (when (slot.setter new-slot)
       (add-method (slot.setter new-slot)
                   (make-each-subclass-setter class
                                              (length (class.class-data class))
                                              (slot.type new-slot)
                                              (slot.getter new-slot))))
     (setf (class.class-data class)
           (grow-vector (class.class-data class)
                        (get-initial-slot-value new-slot))))
    ((class)
     (let ((data-location (slot.data-location new-slot)))
       (when (eq class (car data-location))
         (let ((offset (cdr data-location)))
           (setf (class.class-data class)
                 (grow-vector (class.class-data class)
                              (get-initial-slot-value new-slot)))
           (add-method (slot.getter new-slot)
                       (make-class-getter class offset
                                          (slot.debug-name new-slot)))
           (when (slot.setter new-slot)
             (add-method (slot.setter new-slot)
                         (make-class-setter class offset
                                            (slot.type new-slot))))))))
    ((constant)
     (add-method (slot.getter new-slot)
                 (make-constant-getter class (slot.data-location new-slot))))
    ((virtual) t)))

(defun add-slot-to-singleton! (singleton new-slot)
  (when (eq (slot.allocation new-slot) 'instance)
    (setf (singleton.extra-slot-values singleton)
          (grow-vector (singleton.extra-slot-values singleton)
                       (get-initial-slot-value new-slot)))
    ;; The Scheme called MAKE-SINGLETON-GETTER and -SETTER with one
    ;; argument too few; the specializer for a singleton's accessors is
    ;; the singleton itself.
    (add-method (slot.getter new-slot)
                (make-singleton-getter singleton singleton
                                       (slot.data-location new-slot)
                                       (slot.debug-name new-slot)))
    (when (slot.setter new-slot)
      (add-method (slot.setter new-slot)
                  (make-singleton-setter singleton singleton
                                         (slot.data-location new-slot)
                                         (slot.type new-slot)))))
  (when (eq (slot.allocation new-slot) 'constant)
    (add-method (slot.getter new-slot)
                (make-constant-getter singleton (slot.data-location new-slot)))))

(defun dylan%add-slot (owner type allocation setter getter debug-name
                        init-value has-init-value? init-function init-keyword
                        required-init-keyword)
  (labels ((figure-data-location (current-class allocation)
             (if (class? current-class)
                 (case allocation      ; CLASS
                   ((virtual) nil)
                   ((constant) init-value)
                   ((instance) (class.instance-data-size current-class))
                   ((each-subclass) (length (class.class-data current-class)))
                   ((class) (cons owner (length (class.class-data owner)))))
                 (case allocation      ; SINGLETON
                   ((virtual) nil)
                   ((constant) init-value)
                   ((instance)
                    (length (singleton.extra-slot-values current-class)))
                   (t (dylan-call dylan/error
                                  "dylan%add-slot -- bad allocation for singleton"
                                  current-class debug-name allocation))))))
    (cond ((singleton? owner)
           (unless (member allocation '(instance constant virtual))
             (dylan-call dylan/error
                         "dylan%add-slot -- bad singleton allocation"
                         allocation))
           (when init-keyword
             (dylan-call dylan/error
                         "dylan%add-slot -- singleton with init-keyword"
                         init-keyword)))
          ((and (class? owner) (class.read-only? owner))
           (dylan-call dylan/error "add-slot -- class is read-only" owner))
          ((not (class? owner))
           (dylan-call dylan/error
                       "dylan%add-slot -- owner not a singleton or class"
                       owner)))
    (when (and required-init-keyword
               (or init-keyword has-init-value? init-function))
      (dylan-call dylan/error
                  "dylan%add-slot -- incompatible slot initialization"
                  'required-init-keyword required-init-keyword
                  'init-keyword init-keyword
                  'init-value init-value
                  'init-function init-function))
    (when (and has-init-value? init-function)
      (dylan-call dylan/error
                  "dylan%add-slot -- both initial value and function"
                  'init-value init-value
                  'init-function init-function))
    (unless (member allocation '(instance class each-subclass constant virtual))
      (dylan-call dylan/error "dylan%add-slot -- bad allocation type"
                  allocation))
    (when (and (member allocation '(class each-subclass))
               (or init-function required-init-keyword init-keyword))
      (dylan-call dylan/error
                  "dylan%add-slot -- bad combination of allocation and initialization"
                  allocation init-function required-init-keyword init-keyword))
    (let ((new-slot (make-slot debug-name getter setter type init-value
                               has-init-value? init-function init-keyword
                               required-init-keyword allocation nil
                               (figure-data-location owner allocation))))
      (if (class? owner)
          (progn
            (add-a-slot owner new-slot
                        #'class.slots #'set-class-slots!
                        #'add-slot-to-class!)
            (map-over-all-subclasses!
             (lambda (class)
               ;; Stop showering down if we hit a class that already has a
               ;; generic function for this slot.
               (not (member getter (map 'list #'(lambda (s)
                                                  (and s (slot.getter s)))
                                        (class.slots class)))))
             (lambda (class test)
               (if test
                   (add-a-slot class
                               ;; A class slot's storage stays with its
                               ;; owner, whose class data has already grown
                               ;; by now, so subclasses share the owner's
                               ;; location rather than computing one.
                               (copy-slot new-slot t
                                          (if (eq allocation 'class)
                                              (slot.data-location new-slot)
                                              (figure-data-location
                                               class allocation)))
                               #'class.slots #'set-class-slots!
                               #'add-slot-to-class!)
                   (conflict-test class (copy-slot new-slot t 0))))
             (class.subclasses owner)))
          (add-a-slot owner new-slot    ; SINGLETON
                      #'singleton.extra-slot-descriptors
                      #'set-singleton-extra-slot-descriptors!
                      #'add-slot-to-singleton!))
      new-slot)))

;;; REMOVE-SLOT (chapter 11).  The Scheme never implemented it.  The slot
;;; goes from OWNER and from every subclass that inherits it only through
;;; OWNER, together with the accessor methods made for it; a virtual slot's
;;; methods are the user's and stay.  Instances are updated at once rather
;;; than as they are accessed: the slot's storage is emptied and left in
;;; place.

(defun remove-slot-accessors! (specializer slot)
  (unless (eq (slot.allocation slot) 'virtual)
    (flet ((remove-from (generic-function specializers)
             (let ((method (and generic-function
                                (find-method generic-function specializers))))
               (when method (delete-method! generic-function method)))))
      (remove-from (slot.getter slot) (list specializer))
      (remove-from (slot.setter slot) (list specializer <object>)))))

(defun dylan%remove-slot (owner slot-descriptor)
  (let ((getter (slot.getter slot-descriptor)))
    (cond ((singleton? owner)
           (let* ((slots (singleton.extra-slot-descriptors owner))
                  (slot (same-slot-getter-in-slot-vector->slot getter slots)))
             (unless slot
               (dylan-call dylan/error "remove-slot -- no such slot"
                           owner slot-descriptor))
             (remove-this-slot-only! owner slots slot)
             (remove-slot-accessors! owner slot)))
          ((not (class? owner))
           (dylan-call dylan/error
                       "remove-slot -- owner not a singleton or class" owner))
          ((class.read-only? owner)
           (dylan-call dylan/error "remove-slot -- class is read-only" owner))
          (t
           (let ((slot (same-slot-getter-in-slot-vector->slot
                        getter (class.slots owner))))
             (cond ((null slot)
                    (dylan-call dylan/error "remove-slot -- no such slot"
                                owner slot-descriptor))
                   ((slot.inherited? slot)
                    (dylan-call dylan/error
                                "remove-slot -- slot is inherited, not the class's own"
                                owner slot-descriptor)))
             (flet ((remove-from-class (class slot)
                      (if (slot.filtered slot)
                          ;; The slot it filtered, and its storage, return.
                          (setf (aref (class.slots class)
                                      (position slot (class.slots class)))
                                (copy-slot (slot.filtered slot) t
                                           (slot.data-location
                                            (slot.filtered slot))))
                          (progn
                            (remove-this-slot-only! class (class.slots class)
                                                    slot)
                            (remove-slot-accessors! class slot)))))
               (remove-from-class owner slot)
               (map-over-all-subclasses!
                (lambda (class)
                  (let ((inherited (same-slot-getter-in-slot-vector->slot
                                    getter (class.slots class))))
                    (and inherited (slot.inherited? inherited))))
                (lambda (class test)
                  ;; Keep the slot where another superclass still supplies
                  ;; it; a filtered slot's copies always go back.
                  (when (and test
                             (or (slot.filtered slot)
                                 (notany (lambda (super)
                                           (same-slot-getter-in-slot-vector->slot
                                            getter (class.slots super)))
                                         (class.superclasses class))))
                    (remove-from-class
                     class
                     (same-slot-getter-in-slot-vector->slot
                      getter (class.slots class)))))
                (class.subclasses owner))))))
    slot-descriptor))

;;; (SETTER DIRECT-SUPERCLASSES) (chapter 11) remakes CLASS so that it
;;; inherits from NEW-SUPERCLASSES.  The Scheme never implemented it.  CLASS
;;; and every class below it are rebuilt as MAKE-DYLAN-CLASS and
;;; DYLAN%ADD-SLOT would have built them, parents before children: the
;;; inherited slots come from the new superclasses, the class's own slots
;;; are added back after them, and the accessor methods follow.  Existing
;;; instances keep the value of every slot that survives (matched by getter)
;;; and take initial values for the slots that are new to them.

(defun class-descendants (class)
  (let ((result '()))
    (labels ((walk (c)
               (map-over-population!
                (class.subclasses c)
                (lambda (sub)
                  (unless (member sub result)
                    (push sub result)
                    (walk sub))))))
      (walk class))
    result))

(defun remove-class-accessors! (class)
  "Remove the accessor methods CLASS's slots put on CLASS itself."
  (vector-iterate
   (class.slots class)
   (lambda (index slot)
     (declare (ignore index))
     (when (and slot
                (or (member (slot.allocation slot)
                            '(instance each-subclass))
                    (and (member (slot.allocation slot) '(class constant))
                         (not (slot.inherited? slot)))))
       (remove-slot-accessors! class slot)))))

(defun rebuild-class! (class)
  (let* ((old-slots (class.slots class))
         (old-class-data (class.class-data class))
         (own-slots (loop for slot across old-slots
                          when (and slot (not (slot.inherited? slot)))
                            collect slot))
         (instances (class.instances class)))
    (remove-class-accessors! class)
    ;; Build the new layout with no instances attached, so that adding the
    ;; own slots does not touch them; they are converted below.
    (setf (class.instances class) (make-population*))
    (let* ((combined (combine-slots class (class.superclasses class)
                                    (mapcar #'slot.getter own-slots)))
           (slots (aref combined 0)))
      (setf (class.slots class) slots
            (class.instance-data-size class) (aref combined 2)
            (class.class-data class)
            (let ((data (make-array (aref combined 1)
                                    :initial-element
                                    *the-uninitialized-slot-value*)))
              (vector-iterate slots
                              (lambda (i slot)
                                (declare (ignore i))
                                (initialize-slot! slot '() data
                                                  '(each-subclass))))
              data))
      (dolist (slot own-slots)
        (add-a-slot class
                    (copy-slot slot nil
                               (case (slot.allocation slot)
                                 ((instance) (class.instance-data-size class))
                                 ((each-subclass)
                                  (length (class.class-data class)))
                                 ((class)
                                  (cons class (length (class.class-data class))))
                                 (t (slot.data-location slot))))
                    #'class.slots #'set-class-slots! #'add-slot-to-class!)))
    (setf (class.instances class) instances)
    (flet ((old-slot (new-slot)
             ;; The old storage for NEW-SLOT's storage, if it is alike.
             (let ((slot (same-slot-getter-in-slot-vector->slot
                          (slot.getter new-slot) old-slots)))
               (and slot
                    (slot-storage slot)
                    (eq (slot.allocation (slot-storage slot))
                        (slot.allocation new-slot))
                    (slot-storage slot)))))
      ;; Class data this class owns keeps its value.
      (vector-iterate
       (class.slots class)
       (lambda (index slot)
         (declare (ignore index))
         (setf slot (and slot (slot-storage slot)))
         (let ((old (and slot (old-slot slot))))
           (when old
             (case (slot.allocation slot)
               ((each-subclass)
                (setf (aref (class.class-data class) (slot.data-location slot))
                      (aref old-class-data (slot.data-location old))))
               ((class)
                (when (and (eq (car (slot.data-location slot)) class)
                           (eq (car (slot.data-location old)) class))
                  (setf (aref (class.class-data class)
                              (cdr (slot.data-location slot)))
                        (aref old-class-data
                              (cdr (slot.data-location old)))))))))))
      ;; Instance data is laid out afresh.
      (map-over-population!
       instances
       (lambda (instance)
         (let ((old-data (instance.data instance))
               (data (make-array (class.instance-data-size class)
                                 :initial-element
                                 *the-uninitialized-slot-value*)))
           (vector-iterate
            (class.slots class)
            (lambda (index slot)
              (declare (ignore index))
              (setf slot (and slot (slot-storage slot)))
              (when (and slot (eq (slot.allocation slot) 'instance))
                (let ((old (old-slot slot)))
                  (setf (aref data (slot.data-location slot))
                        (if old
                            (aref old-data (slot.data-location old))
                            (get-initial-slot-value slot)))))))
           (setf (instance.data instance) data)))))))

(defun dylan%set-direct-superclasses (class new-superclasses)
  (let ((supers (dylan-call dylan/as <list> new-superclasses)))
    (cond ((class.read-only? class)
           (dylan-call dylan/error
                       "(setter direct-superclasses) -- class is read-only"
                       class))
          ((eq class <object>)
           (dylan-call dylan/error
                       "(setter direct-superclasses) -- cannot remake <object>"))
          ((null supers)
           (dylan-call dylan/error "must specify at least one superclass"))
          ((notevery #'class? supers)
           (dylan-call dylan/error
                       "(setter direct-superclasses) -- not a class"
                       new-superclasses))
          ((not (unique? supers #'member))
           (dylan-call dylan/error
                       "multiple inheritance from identical superclasses")))
    (dolist (super supers)
      (when (class.sealed? super)
        (dylan-call dylan/error "cannot subclass a sealed class" super))
      (when (subclass? super class)
        (dylan-call dylan/error
                    "(setter direct-superclasses) -- circular inheritance"
                    class super)))
    (let* ((old-supers (class.superclasses class))
           (affected (cons class (class-descendants class)))
           (done nil))
      ;; Install the new superclasses and check every precedence list that
      ;; changes; on any error, put the old ones back.
      (unwind-protect
           (progn
             (setf (class.superclasses class) supers)
             (dolist (c affected) (setf (class.precedence-list c) nil))
             (mapc #'class-precedence-list affected)
             (setf done t))
        (unless done
          (setf (class.superclasses class) old-supers)
          (dolist (c affected) (setf (class.precedence-list c) nil))))
      (dolist (super old-supers)
        (remove-from-population! (class.subclasses super) class))
      (dolist (super supers)
        (add-to-population! (class.subclasses super) class))
      ;; A class's precedence list is longer than any of its superclasses',
      ;; so this order rebuilds parents before children.
      (dolist (c (sort (copy-list affected) #'<
                       :key (lambda (c) (length (class-precedence-list c)))))
        (rebuild-class! c))
      (recompute-class-specificities!)
      new-superclasses)))

(defun make-getter-param-list (class)
  (make-param-list `((obj ,class)) nil nil nil))

(defun make-setter-param-list (class)
  (make-param-list `((obj ,class) (value ,<object>)) nil nil nil))

(defun object-ref (data offset object name)
  (let ((value (aref data offset)))
    (if (eq value *the-uninitialized-slot-value*)
        (dylan-call dylan/error "uninitialized slot accessed" object name)
        value)))

(defun make-class-getter (class offset name)
  (dylan%function->method
   (make-getter-param-list class)
   (lambda (obj)
     (declare (ignore obj))
     (object-ref (class.class-data class) offset class name))))

;;; An instance or each-subclass accessor method made for CLASS may be
;;; reached, by NEXT-METHOD from a filtered slot's methods, with an instance
;;; of a subclass whose layout differs; it then finds the slot's location in
;;; that subclass.

(defmacro with-slot-offset ((var obj class offset getter) &body body)
  `(let ((,var (if (eq (instance.class ,obj) ,class)
                   ,offset
                   (storage-location (instance.class ,obj) ,getter))))
     ,@body))

(defun make-each-subclass-getter (class offset name getter)
  (dylan%function->method
   (make-getter-param-list class)
   (lambda (obj)
     (with-slot-offset (offset obj class offset getter)
       (let ((class (instance.class obj)))
         (object-ref (class.class-data class) offset class name))))))

(defun make-instance-getter (class offset name getter)
  (dylan%function->method
   (make-getter-param-list class)
   (lambda (obj)
     (with-slot-offset (offset obj class offset getter)
       (object-ref (instance.data obj) offset obj name)))))

(defun make-singleton-getter (class singleton offset name)
  (dylan%function->method
   (make-getter-param-list class)
   (lambda (obj)
     (declare (ignore obj))
     (object-ref (singleton.extra-slot-values singleton) offset
                 singleton name))))

(defun make-class-setter (class offset type)
  (dylan%function->method
   (make-setter-param-list class)
   (if (eq type <object>)
       (lambda (obj value)
         (declare (ignore obj))
         (setf (aref (class.class-data class) offset) value))
       (lambda (obj value)
         (declare (ignore obj))
         (dylan-call dylan/check-type value type)
         (setf (aref (class.class-data class) offset) value)))))

(defun make-each-subclass-setter (class offset type getter)
  (dylan%function->method
   (make-setter-param-list class)
   (lambda (obj value)
     (unless (eq type <object>)
       (dylan-call dylan/check-type value type))
     (with-slot-offset (offset obj class offset getter)
       (setf (aref (class.class-data (instance.class obj)) offset) value)))))

(defun make-instance-setter (class offset type getter)
  (dylan%function->method
   (make-setter-param-list class)
   (lambda (obj value)
     (unless (eq type <object>)
       (dylan-call dylan/check-type value type))
     (with-slot-offset (offset obj class offset getter)
       (setf (aref (instance.data obj) offset) value)))))

(defun make-singleton-setter (class singleton offset type)
  (dylan%function->method
   (make-setter-param-list class)
   (if (eq type <object>)
       (lambda (obj value)
         (declare (ignore obj))
         (setf (aref (singleton.extra-slot-values singleton) offset) value))
       (lambda (obj value)
         (declare (ignore obj))
         (dylan-call dylan/check-type value type)
         (setf (aref (singleton.extra-slot-values singleton) offset) value)))))

(defun make-constant-getter (class constant)
  (dylan%function->method
   (make-getter-param-list class)
   (lambda (obj) (declare (ignore obj)) constant)))

(defun dylan%make-singleton (object)
  (if (instance? object)
      (or (instance.singleton object)
          (let ((singleton (make-singleton object (vector) (vector))))
            (setf (instance.singleton object) singleton)
            singleton))
      (make-singleton object (vector) (vector))))
