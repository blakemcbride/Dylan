    ;; Reflection (chapters 10 and 11)
    ("function-arguments" . "function_arguments")
    ("slot-getter" . "slot_getter") ("slot-setter" . "slot_setter")
    ("slot-type" . "slot_type") ("slot-allocation" . "slot_allocation")
