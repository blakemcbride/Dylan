;;;; Write c/casemap.h, the case mapping of the compiled programs' runtime:
;;;; every character whose char-upcase or char-downcase is another, as the
;;;; SBCL that runs the interactive implementation gives them, so that the
;;;; two implementations map case alike whatever the C library's locale
;;;; tables say.  Run it again when SBCL's Unicode version changes:
;;;;
;;;;     sbcl --script runtime/casemap.lisp

(defun mapping (function)
  (loop for code below char-code-limit
        for c = (code-char code)
        when (and c (char/= c (funcall function c)))
          collect (cons code (char-code (funcall function c)))))

(defun write-table (out name pairs)
  (format out "static const uint32_t ~a[][2] = {" name)
  (loop for (from . to) in pairs
        for i from 0
        do (format out "~:[ ~;~%   ~]{0x~x, 0x~x}," (zerop (mod i 4)) from to))
  (format out "~%};~%~%"))

(with-open-file (out (merge-pathnames "c/casemap.h" *load-truename*)
                     :direction :output :if-exists :supersede)
  (format out "/* Generated by runtime/casemap.lisp from ~a ~a.  Do not edit.~%"
          (lisp-implementation-type) (lisp-implementation-version))
  (format out " * Each character whose case maps to another, and that other,~%")
  (format out " * sorted: Common Lisp's char-upcase and char-downcase. */~%~%")
  (write-table out "dy_upcase_table" (mapping #'char-upcase))
  (write-table out "dy_downcase_table" (mapping #'char-downcase)))
